# App
APP_NAME=Import SAP
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=import_sap_session
SESSION_MAX_AGE=28800

# Host port for the web application
APP_PORT=8000

# Display
TIMEZONE=Asia/Jakarta

# Database
POSTGRES_USER=importsap
POSTGRES_PASSWORD=importsap
POSTGRES_DB=importsap
POSTGRES_HOST=db
POSTGRES_PORT=5432

POSTGRES_HOST_PORT=5431

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Import limits
MAX_UPLOAD_SIZE_MB=100
BATCH_SIZE=1000
UPLOAD_DIR=uploads
PREVIEW_ERROR_SAMPLE=200
RECORD_ERROR_SAMPLE=500

# Bootstrap admin (created on startup if no users exist)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@mrtjakarta.co.id
BOOTSTRAP_ADMIN_PASSWORD=admin123

# Backup
BACKUP_RETENTION_DAYS=14
